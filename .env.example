PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiretrack_tickets
TICKETS_STORE_MODE=memory

BITRIX24_PORTAL=https://yourcompany.bitrix24.ru
BITRIX24_WEBHOOK_TOKEN=xxxxx
BITRIX24_USER_ID=1
BITRIX24_ENTITY_TYPE_ID=128

HIRETRACKNX_API_URL=https://example.invalid
HIRETRACKNX_API_KEY=xxxxx

# Direct read-only HireTrack stock-take access (32-bit ODBC DSN)
HIRETRACK_PYTHON=C:\Path\To\32-bit\python.exe
HIRETRACK_ODBC_DSN=HireTrack DSN
HIRETRACK_ODBC_TIMEOUT_MS=90000
HIRETRACK_ODBC_QUERY_TIMEOUT=60
STOCKTAKE_ODBC_CACHE_MS=30000

# Equipment catalog (Hetype) read cache - see EQUIPMENT_CATALOG_MATCH_BLUEPRINT.md.
# Uses the same read-only DSN above. Full catalog re-query only ever runs once;
# every later refresh is a cheap Lookups_LOG delta.
EQUIPMENT_CATALOG_SYNC_MS=600000
EQUIPMENT_CATALOG_SNAPSHOT_PATH=./data/equipment-catalog-snapshot.json

# Separate WRITABLE DSN for the equipment-catalog-match Note write path
# (CreateNewNote + notebookdetails). Must NOT be the same DSN as
# HIRETRACK_ODBC_DSN above, which is read-only. No default on purpose - the
# write bridge refuses to run until this is set explicitly.
HIRETRACK_WRITE_ODBC_DSN=
HIRETRACK_WRITE_ODBC_TIMEOUT_MS=30000
HIRETRACK_WRITE_ODBC_QUERY_TIMEOUT=60

# Crew Bookings page (/crew-bookings/) - own DSNs, separate from the pair
# above. While the write path is still being validated, point
# CREW_WRITE_ODBC_DSN at "Claude Test" (TestDB) rather than a real writable
# prod DSN; flip it once trusted. No default on purpose - the write bridge
# refuses to run until this is set explicitly.
CREW_ODBC_DSN=HireTrack DSN
CREW_ODBC_TIMEOUT_MS=90000
CREW_ODBC_QUERY_TIMEOUT=60
CREW_ODBC_HORIZON_DAYS=60
CREW_ODBC_CACHE_MS=30000
CREW_WRITE_ODBC_DSN=
CREW_WRITE_ODBC_TIMEOUT_MS=30000
CREW_WRITE_ODBC_QUERY_TIMEOUT=60

# Second, page-scoped PIN gate on /crew-bookings and /api/crew-bookings, on
# top of the main password above - crew assignment writes into production
# HireTrack, so this page gets its own short PIN as a deliberate extra step.
CREW_BOOKINGS_PIN=3359
CREW_BOOKINGS_PIN_SESSION_DAYS=30
